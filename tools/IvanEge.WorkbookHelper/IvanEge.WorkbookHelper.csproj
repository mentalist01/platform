<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IvanEgeWorkbookHelper</AssemblyName>
    <RootNamespace>IvanEge.WorkbookHelper</RootNamespace>
    <AssemblyTitle>Иван на сотку — помощник таблиц</AssemblyTitle>
    <Product>Иван на сотку</Product>
    <Company>Иван на сотку</Company>
    <Description>Безопасно открывает учебные таблицы с ivan100.ru в Excel или LibreOffice и синхронизирует сохранения.</Description>
    <Copyright>Иван на сотку</Copyright>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Version>1.3.2</Version>
    <FileVersion>1.3.2.0</FileVersion>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
