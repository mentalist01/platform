# Frontend runtime URLs for the Android build.
# Use the site root, not the /api path.
VITE_API_BASE_URL=https://your-domain.ru
VITE_UPLOADS_BASE_URL=https://your-domain.ru
VITE_COLLAB_WS_URL=wss://your-domain.ru/collab
VITE_RTC_WS_URL=wss://your-domain.ru/rtc
# HTTPS page in Microsoft Store, or a same-origin path to the temporary direct
# Windows build. Direct EXE downloads may trigger SmartScreen or antivirus until
# the Store release is available. Leave empty to hide installation UI.
# VITE_WORKBOOK_HELPER_INSTALL_URL=/downloads/IvanEgeWorkbookHelper.exe
# VITE_WORKBOOK_HELPER_INSTALL_URL=https://apps.microsoft.com/detail/your-product-id
# WebRTC in production needs TURN, otherwise some networks will hang on "connecting".
# Example JSON:
# VITE_RTC_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.your-domain.ru:3478?transport=udp","turns:turn.your-domain.ru:5349?transport=tcp"],"username":"turn-user","credential":"turn-password"}]
# Optional when TURN is configured:
# VITE_RTC_ICE_TRANSPORT_POLICY=relay

# Server-side CORS/cookie settings for requests coming from Capacitor WebView.
APP_PUBLIC_URL=https://your-domain.ru
APP_ALLOWED_ORIGINS=http://localhost,capacitor://localhost,ionic://localhost
AUTH_COOKIE_SAME_SITE=None
AUTH_COOKIE_SECURE=true
# Stable server-only secret used to locate an account before the expensive scrypt check.
# Keep it unchanged after deployment and never expose it through a VITE_* variable.
ACCESS_CODE_LOOKUP_SECRET=replace-with-a-long-random-secret

# Optional two-way Google Calendar access. The existing private iCal URL remains
# responsible for importing lessons; OAuth is used only to mark and restore the
# selected occurrence when a teacher cancels it in the platform.
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=https://your-domain.ru/api/teacher-calendar-google/oauth/callback
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-secret

# Persistent storage outside the app repo on the server.
PLATFORM_DATA_DIR=/root/platform-data
PLATFORM_UPLOADS_DIR=/root/platform-uploads
PLATFORM_COLLAB_DIR=/root/platform-collab

# Mini-groups (2-5 students). Set to 0 for an emergency rollback to legacy 1:1 only.
LEARNING_GROUPS_ENABLED=1
# Mini-group lessons use Yandex Telemost. Keep native rtc:lesson:* disabled.
LEARNING_GROUP_RTC_ENABLED=0

# Optional student download/upload traffic limit per month.
# Omit these vars, or set either value to 0, to keep the limit disabled.
# STUDENT_TRAFFIC_LIMIT_BYTES=2147483648
# STUDENT_TRAFFIC_LIMIT_GB=2

# Board docs are persisted via snapshot files in PLATFORM_COLLAB_DIR/board-snapshots.
# Old BOARD_COLLAB_PERSISTENCE is ignored so y-leveldb replay does not freeze the server.
# BOARD_COLLAB_PERSISTENCE=1
# BOARD_COLLAB_SNAPSHOT_PERSISTENCE=1
# BOARD_COLLAB_SNAPSHOT_WRITE_DEBOUNCE_MS=60000
# BOARD_ASSET_MAX_FILE_BYTES=10485760
# BOARD_ASSET_MAX_TOTAL_BYTES_PER_STUDENT=268435456

# Optional private Timeweb S3 bucket for compact lesson audio (Opus, direct browser upload).
# Create a dedicated S3 user with read/write access only to this bucket. Never expose
# these values through VITE_* variables. The bucket CORS must allow PUT/GET/HEAD from
# the real platform origin and expose ETag.
# LESSON_REPLAY_S3_ENDPOINT=https://s3.twcstorage.ru
# LESSON_REPLAY_S3_REGION=ru-1
# LESSON_REPLAY_S3_BUCKET=your-private-bucket
# LESSON_REPLAY_S3_ACCESS_KEY_ID=replace-with-dedicated-key
# LESSON_REPLAY_S3_SECRET_ACCESS_KEY=replace-with-dedicated-secret
# LESSON_REPLAY_S3_PREFIX=lesson-audio
# LESSON_REPLAY_AUDIO_MAX_LESSON_BYTES=33554432

# Persist sliding session expiration at most once per 15 minutes under steady traffic.
# AUTH_SESSION_PERSIST_MIN_EXTENSION_MS=900000

# Bound server-side Python fallback checks. Normal browser checks still run locally.
# PYTHON_RUN_TIMEOUT_MS=3000
# PYTHON_RUN_TOTAL_TIMEOUT_MS=8000
# PYTHON_RUN_MAX_CONCURRENT=1
# PYTHON_RUN_MAX_QUEUE=6
# PYTHON_RUN_RATE_LIMIT=6
# PYTHON_RUN_RATE_WINDOW_MS=60000

# Optional but recommended for web push in the browser.
PUSH_VAPID_SUBJECT=mailto:you@your-domain.ru

# MacroDroid -> T-Bank push notification webhook.
# Use a long random value and pass it from MacroDroid as secret or X-Payment-Secret.
MACRODROID_PAYMENT_SECRET=change-this-long-random-secret
# Required when the server has more than one teacher account.
# PAYMENT_NOTIFICATION_TEACHER_ID=teacher-id

# RuStore Push backend settings for Android APK notifications.
RUSTORE_PUSH_PROJECT_ID=your-rustore-project-id
RUSTORE_PUSH_SERVICE_TOKEN=your-rustore-service-token
RUSTORE_PUSH_DEEP_LINK_BASE=ru.ivank.egeplatform://open
RUSTORE_PUSH_NOTIFICATION_CHANNEL_ID=ege_platform_general

# Optional: mirror student help requests to the teacher's Telegram.
# A request is always saved in the platform chat first.
# TELEGRAM_HELP_BOT_TOKEN=123456789:replace-with-bot-token
# TELEGRAM_TEACHER_CHAT_IDS_JSON={"teacher-id":"123456789"}
# Optional fallback for one explicitly named teacher. Both values are required,
# otherwise the fallback is ignored to avoid sending a student's data to the wrong teacher.
# TELEGRAM_HELP_SINGLE_TEACHER_ID=teacher-id
# TELEGRAM_HELP_CHAT_ID=123456789
# Public site root used by the "Open platform chat" Telegram button.
# APP_PUBLIC_URL=https://your-domain.ru
