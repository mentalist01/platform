# Frontend runtime URLs for the Android build.
# Use the site root, not the /api path.
VITE_API_BASE_URL=https://your-domain.ru
VITE_UPLOADS_BASE_URL=https://your-domain.ru
VITE_COLLAB_WS_URL=wss://your-domain.ru/collab
VITE_RTC_WS_URL=wss://your-domain.ru/rtc

# Server-side CORS/cookie settings for requests coming from Capacitor WebView.
APP_ALLOWED_ORIGINS=http://localhost,capacitor://localhost,ionic://localhost
AUTH_COOKIE_SAME_SITE=None
AUTH_COOKIE_SECURE=true

# Persistent storage outside the app repo on the server.
PLATFORM_DATA_DIR=/root/platform-data
PLATFORM_UPLOADS_DIR=/root/platform-uploads
PLATFORM_COLLAB_DIR=/root/platform-collab

# Board docs are persisted via snapshot files in PLATFORM_COLLAB_DIR/board-snapshots.
# Old BOARD_COLLAB_PERSISTENCE is ignored so y-leveldb replay does not freeze the server.
# BOARD_COLLAB_PERSISTENCE=1
# BOARD_COLLAB_SNAPSHOT_PERSISTENCE=1
# BOARD_COLLAB_SNAPSHOT_WRITE_DEBOUNCE_MS=2500

# Optional but recommended for web push in the browser.
PUSH_VAPID_SUBJECT=mailto:you@your-domain.ru

# RuStore Push backend settings for Android APK notifications.
RUSTORE_PUSH_PROJECT_ID=your-rustore-project-id
RUSTORE_PUSH_SERVICE_TOKEN=your-rustore-service-token
RUSTORE_PUSH_CLICK_ACTION=ru.ivank.egeplatform.PUSH_OPEN
RUSTORE_PUSH_NOTIFICATION_CHANNEL_ID=ege_platform_general
